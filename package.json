{
  "name": "magpie-zenmux",
  "version": "0.1.0",
  "description": "ZenMux provider plugin for Magpie and OpenCode: Builder Plan (Subscription) and Pay-As-You-Go support, 5-hour/7-day Flow windows, reset counts, PAYG balance, per-plan model filtering, and native multi-protocol routing",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "models.mjs",
    "assets",
    "scripts",
    "tests",
    "README.md",
    "VALIDATION.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "provider",
    "zenmux"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NieiR/magpie-zenmux.git"
  },
  "homepage": "https://github.com/NieiR/magpie-zenmux#readme",
  "bugs": {
    "url": "https://github.com/NieiR/magpie-zenmux/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "https://raw.githubusercontent.com/NieiR/magpie-zenmux/main/assets/icon.svg"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  }
}
